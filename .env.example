# rd-pulse — copy this file to .env and fill in your values
# cp .env.example .env

# ── GitHub ────────────────────────────────────────────────────────────────────
# Personal access token with `repo` scope
# Generate at: https://github.com/settings/tokens → New token (classic)
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# The GitHub org or username and repo to analyse
GITHUB_OWNER=your-org
GITHUB_REPO=your-repo

# ── OpenAI ────────────────────────────────────────────────────────────────────
# API key (paid plan required — GPT-4o)
# Generate at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxx

# ── Jira ──────────────────────────────────────────────────────────────────────
# Your Atlassian domain (include https://)
JIRA_DOMAIN=https://your-org.atlassian.net

# Atlassian account email
JIRA_EMAIL=you@yourcompany.com

# Jira API token (NOT your password)
# Generate at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_TOKEN=your_jira_api_token_here

# Jira board ID — the number in the URL when viewing your board (.../boards/42)
JIRA_BOARD=42

# ── Schedule ──────────────────────────────────────────────────────────────────
# Cron expression for automatic report generation (Docker only)
# Default: 8 AM weekdays Mon-Fri
CRON_SCHEDULE=0 8 * * 1-5

# Days of GitHub history to include in each report
DAYS=1

# ── Optional ──────────────────────────────────────────────────────────────────
# Override the OpenAI model (default: gpt-4o)
# MODEL=gpt-4o-mini
