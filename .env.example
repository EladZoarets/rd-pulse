# ── Stage 1: GitHub + OpenAI ──────────────────────────────────────────────────

# GitHub personal access token with `repo` scope
# Generate at: https://github.com/settings/tokens
GITHUB_TOKEN=your_github_token_here

# OpenAI API key
# Generate at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# ── Stage 2: Slack ────────────────────────────────────────────────────────────

# Slack bot token (starts with xoxb-)
# Create a Slack app at: https://api.slack.com/apps
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Comma-separated channel IDs to monitor (e.g. C01234567,C07654321)
SLACK_CHANNEL_IDS=C01234567,C07654321

# ── Stage 2: Jira ─────────────────────────────────────────────────────────────

# Your Atlassian domain (e.g. https://your-org.atlassian.net)
JIRA_DOMAIN=https://your-org.atlassian.net

# Atlassian account email
JIRA_EMAIL=you@yourorg.com

# Jira API token
# Generate at: https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_TOKEN=your_jira_api_token_here
